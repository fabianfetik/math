theorem second_cover (h : Fin 6 → ℝ) (delta : ℝ)
    (horder : ∀ i j : Fin 6, i.val ≤ j.val → h j ≤ h i)
    (hheads : ∀ i, delta ≤ h i)
    (hsum : (∑ i : Fin 6, h i) + delta = (5 : ℝ)/6)
    (hlower : (1/10 : ℝ) ≤ delta) (hupper : delta ≤ (5/44 : ℝ))
    (hfail0 : 1 < 8*h 0) (hfail1 : 1 < 2*h 0+6*h 2)
    (hfail2 : 1 < 4*h 0+4*h 4) (hfail3 : 1 < 6*h 0+2*delta)
    (hmarkL : 2*delta ≤ h 0) (hmarkR : h 1 ≤ 2*delta)
    : ∃ S : ℤ → Fin 7, WeakValidRates (fun i => weakSevenRates h delta (Equiv.swap 0 1 i)) S := by
  classical
  have ctx := SecondCtx.of_rates h delta horder hheads hsum hlower hupper
    hfail0 hfail1 hfail2 hfail3 hmarkL hmarkR
  have hd : 0 < delta := by linarith only [hlower]
  have hr := second_positive hd hheads
  rw [← secondRankRates_swap]
  by_contra hn
  apply second_cover_contradiction h delta ctx
  intro sid hfit
  fin_cases sid
  · exact hn (secondWordFitSchedule0 h delta horder hmarkL hmarkR hfit)
  · exact hn (secondWordFitSchedule1 h delta horder hmarkL hmarkR hfit)
  · exact hn (secondWordFitSchedule2 h delta horder hmarkL hmarkR hfit)
  · exact hn (secondWordFitSchedule3 h delta horder hmarkL hmarkR hfit)
