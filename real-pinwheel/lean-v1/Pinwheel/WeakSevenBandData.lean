theorem upper_largest_cover (h : Fin 6 → ℝ) (delta : ℝ)
    (horder : ∀ i j : Fin 6, i.val ≤ j.val → h j ≤ h i)
    (hheads : ∀ i, delta ≤ h i)
    (hsum : (∑ i : Fin 6, h i) + delta = (5 : ℝ)/6)
    (hlower : (5/48 : ℝ) ≤ delta) (hupper : delta ≤ (5/44 : ℝ))
    (hfail0 : 1 < 8*h 0) (hfail1 : 1 < 2*h 0+6*h 2)
    (hfail2 : 1 < 4*h 0+4*h 4) (hfail3 : 1 < 6*h 0+2*delta)
    : ∃ S : ℤ → Fin 7, WeakValidRates (weakSevenRates h delta) S := by
  classical
  have ctx := UpperLargestCtx.of_rates h delta horder hheads hsum hlower hupper
    hfail0 hfail1 hfail2 hfail3
  have hmarkR : h 0 ≤ 2*delta := by linarith [ctx.markR]
  have hd : 0 < delta := by linarith only [hlower]
  have hr := marked_positive hd hheads
  by_contra hn
  apply upper_largest_cover_contradiction h delta ctx
  intro sid hfit
  fin_cases sid
  · exact hn (upperWordFitSchedule0 h delta horder hmarkR hfit)
  · exact hn (upperWordFitSchedule1 h delta horder hmarkR hfit)
