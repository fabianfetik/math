private theorem marked_positive {h : Fin 6 → ℝ} {delta : ℝ}
    (hd : 0 < delta) (hh : ∀ i, delta ≤ h i) :
    ∀ i, 0 < weakSevenRates h delta i := by
  intro i
  refine Fin.cases ?_ ?_ i
  · change 0 < 2*delta
    positivity
  · intro j
    change 0 < h j
    exact lt_of_lt_of_le hd (hh j)

private theorem second_positive {h : Fin 6 → ℝ} {delta : ℝ}
    (hd : 0 < delta) (hh : ∀ i, delta ≤ h i) :
    ∀ i, 0 < secondRankRates h delta i := by
  intro i
  fin_cases i
  · change 0 < h 0
    exact lt_of_lt_of_le hd (hh 0)
  · change 0 < 2*delta
    positivity
  · change 0 < h 1
    exact lt_of_lt_of_le hd (hh 1)
  · change 0 < h 2
    exact lt_of_lt_of_le hd (hh 2)
  · change 0 < h 3
    exact lt_of_lt_of_le hd (hh 3)
  · change 0 < h 4
    exact lt_of_lt_of_le hd (hh 4)
  · change 0 < h 5
    exact lt_of_lt_of_le hd (hh 5)

theorem secondRankRates_swap (h : Fin 6 → ℝ) (delta : ℝ) :
    secondRankRates h delta = fun i => weakSevenRates h delta (Equiv.swap 0 1 i) := by
  funext i
  fin_cases i <;> simp [secondRankRates, weakSevenRates, Equiv.swap_apply_def] <;> rfl

