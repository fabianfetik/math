import CorralFormalization.Results.PrimeHeight.GroupAction

/-! Classification of odd-order physical subgroups on the full clock. -/

namespace CorralFormalization.PhysicalCorral.Motion

variable {M : ℕ}

/-- The rotations are the literal additive translations of the physical cycle. -/
def rotationsHom : Multiplicative (ZMod M) →* Motion M where
  toFun c := rotation c.toAdd
  map_one' := rfl
  map_mul' _ _ := rfl

theorem rotation_orderOf (c : ZMod M) :
    orderOf (rotation c : Motion M) = addOrderOf c := by
  have hi : Function.Injective (rotationsHom (M := M)) := by
    intro a b h
    exact congrArg Multiplicative.ofAdd (rotation.inj h)
  exact (orderOf_injective rotationsHom hi (Multiplicative.ofAdd c)).trans
    (orderOf_ofAdd_eq_addOrderOf c)

end CorralFormalization.PhysicalCorral.Motion

namespace CorralFormalization.Results.PrimeHeight

open PhysicalCorral

/-- The translation by `n` has exactly order `h` on the full clock `h*n`. -/
theorem gap_rotation_order (h n : ℕ) (hh : 0 < h) (hn : 0 < n) :
    orderOf (Motion.rotation (n : ZMod (h*n))) = h := by
  rw [Motion.rotation_orderOf, ZMod.addOrderOf_coe n (Nat.mul_ne_zero (by omega) (by omega))]
  have hg : (h*n).gcd n = n := Nat.gcd_eq_right (dvd_mul_left n h)
  rw [hg, Nat.mul_div_cancel _ hn]

/-- An odd-order subgroup cannot contain a reflection. -/
theorem odd_order_subgroup_no_reflection {M : ℕ} (H : Subgroup (Motion M))
    (hodd : Odd (Nat.card H)) (c : ZMod M) : Motion.reflection c ∉ H := by
  intro hc
  have hp := congrArg Subtype.val (pow_card_eq_one' (x := (⟨Motion.reflection c, hc⟩ : H)))
  change (Motion.reflection c : Motion M) ^ Nat.card H = 1 at hp
  rw [Motion.reflection_pow_odd c hodd] at hp
  cases hp

/-- An order-`h` subgroup on a clock of size `h*n`, with `h` odd, is exactly
the rotations generated by the translation `n`. This supplies the uniqueness
claim used by the paper, with no cyclic-subgroup assumption on the input. -/
theorem odd_order_subgroup_eq_gap_rotations (h n : ℕ)
    (hh : 0 < h) (hn : 0 < n) (hodd : Odd h)
    (H : Subgroup (Motion (h*n))) (hcard : Nat.card H = h) :
    H = Subgroup.zpowers (Motion.rotation (n : ZMod (h*n))) := by
  letI : NeZero (h*n) := ⟨Nat.mul_ne_zero (by omega) (by omega)⟩
  have hle : H ≤ Subgroup.zpowers (Motion.rotation (n : ZMod (h*n))) := by
    intro f hf
    cases f with
    | reflection c =>
      exact False.elim (odd_order_subgroup_no_reflection H (hcard.symm ▸ hodd) c hf)
    | rotation c =>
      have hp := congrArg Subtype.val (pow_card_eq_one' (x := (⟨Motion.rotation c, hf⟩ : H)))
      change (Motion.rotation c : Motion (h*n)) ^ Nat.card H = 1 at hp
      rw [hcard, Motion.rotation_pow, Motion.one_eq] at hp
      have hz : h • c = 0 := Motion.rotation.inj hp
      have hcast : ((h*c.val : ℕ) : ZMod (h*n)) = 0 := by
        simpa only [Nat.cast_mul, nsmul_eq_mul, ZMod.natCast_zmod_val] using hz
      have hd : h*n ∣ h*c.val := (ZMod.natCast_eq_zero_iff _ _).mp hcast
      have hnc : n ∣ c.val := (Nat.mul_dvd_mul_iff_left hh).mp hd
      obtain ⟨k, hk⟩ := hnc
      have hc : c = k • (n : ZMod (h*n)) := by
        rw [nsmul_eq_mul, ← Nat.cast_mul, Nat.mul_comm k n, ← hk]
        exact (ZMod.natCast_zmod_val c).symm
      rw [hc, ← Motion.rotation_pow]
      exact Subgroup.npow_mem_zpowers _ k
  apply Subgroup.eq_of_le_of_card_ge hle
  rw [Nat.card_zpowers, gap_rotation_order h n hh hn, hcard]

theorem odd_order_subgroup_contains_gap_rotation (h n : ℕ)
    (hh : 0 < h) (hn : 0 < n) (hodd : Odd h)
    (H : Subgroup (Motion (h*n))) (hcard : Nat.card H = h) :
    Motion.rotation (n : ZMod (h*n)) ∈ H := by
  rw [odd_order_subgroup_eq_gap_rotations h n hh hn hodd H hcard]
  exact Subgroup.mem_zpowers _

end CorralFormalization.Results.PrimeHeight
